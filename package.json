{
  "name": "blujay-play",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/prepare.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare.mjs && vite build && node scripts/check-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@lichess-org/chessground": "10.4.1",
    "chess.js": "1.4.0",
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "vite": "8.3.1",
    "wrangler": "4.143.1"
  }
}
